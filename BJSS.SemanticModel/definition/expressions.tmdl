expression dummy_customers =
		let
		    // Number of random full names to generate
		    NumberOfRandomNames = 6000,
		
		    // Lists of first names and surnames
		    FirstNames = {"John", "Jane", "Alex", "Emily", "Chris", "Katie", "Michael", "Sarah", "David", "Laura", "Peter", "Lisa", "Paul", "Emma", "Robert", "Anna", "James", "Mia", "William", "Olivia"},
		    Surnames = {"Smith", "Johnson", "Williams", "Brown", "Jones", "Garcia", "Miller", "Davis", "Rodriguez", "Martinez", "Hernandez", "Lopez", "Gonzalez", "Wilson", "Anderson", "Thomas", "Taylor", "Moore", "Jackson", "Martin"},
		
		    // Function to generate a random first name
		    GetRandomFirstName = () => FirstNames{Number.RoundDown(Number.RandomBetween(0, List.Count(FirstNames) - 1))},
		
		    // Function to generate a random surname
		    GetRandomSurname = () => Surnames{Number.RoundDown(Number.RandomBetween(0, List.Count(Surnames) - 1))},
		
		    // Generate a list of random full names
		    RandomFullNames = List.Transform({1..NumberOfRandomNames}, each GetRandomFirstName() & " " & GetRandomSurname()),
		
		    // Convert the list to a table
		    RandomFullNamesTable = Table.FromList(RandomFullNames, Splitter.SplitByNothing(), {"Full Name"}),
		    #"Added Index" = Table.AddIndexColumn(RandomFullNamesTable, "Index", 12300, 1, Int64.Type),
		    #"Changed Type" = Table.TransformColumnTypes(#"Added Index",{{"Full Name", type text}})
		    in
		    #"Changed Type"
	lineageTag: 89d3acde-609e-4b32-9c2a-1053d856f03c

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

