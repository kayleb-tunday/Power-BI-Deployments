table fact_retail
	lineageTag: 246c8403-a04b-4a5a-8da5-41ee80125d7f

	measure InvoicePrice = (CALCULATE(SUM(fact_retail[Price]), fact_retail[InvoiceType] = "Purchase")) - (CALCULATE(SUM(fact_retail[Price]), fact_retail[InvoiceType] = "Cancellation"))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 3fe64c61-5236-4ccd-87c5-ab1d44850581

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure '% Cancellations' = DIVIDE(CALCULATE(COUNT(fact_retail[Invoice]),fact_retail[InvoiceType] = "Cancellation"), CALCULATE(COUNT(fact_retail[Invoice]),fact_retail[InvoiceType] = "Purchase"))
		lineageTag: fc652bef-d122-486c-adab-1f8f5bdf13fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalCancellations = CALCULATE(COUNT(fact_retail[Invoice]),fact_retail[InvoiceType] = "Cancellation")
		formatString: 0
		lineageTag: 16e622bb-7470-4a22-aa16-e79915a7b9b2

	measure TotalPurchases = CALCULATE(COUNT(fact_retail[Invoice]),fact_retail[InvoiceType] = "Purchase")
		formatString: 0
		lineageTag: bfa15aa8-a4dd-495d-a970-eec3cf44233c

