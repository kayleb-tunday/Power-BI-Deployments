		sourceColumn: TimeBuckets

		annotation SummarizationSetBy = Automatic

	partition fact_retail = m
		mode: import
		source = ```
				let
				    Source = online_retail_II,
				    #"Duplicated Column" = Table.DuplicateColumn(Source, "InvoiceDate", "InvoiceTime"),
				    #"Changed Type" = Table.TransformColumnTypes(#"Duplicated Column",{{"InvoiceDate", type date}, {"InvoiceTime", type time}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Description", "Country"}),
				    #"Added Time Buckets" = Table.AddColumn(#"Removed Columns", "TimeBuckets", each if [InvoiceTime] >= #time(0, 0, 0) and [InvoiceTime] <= #time(3, 0, 0) then "Midnight - 3am"
				else
				if [InvoiceTime] >= #time(3, 0, 0) and [InvoiceTime] <= #time(6, 0, 0) then "3am - 6am"
				else
				if [InvoiceTime] >= #time(6, 0, 0) and [InvoiceTime] <= #time(9, 0, 0) then "6am - 9am"
				else
				if [InvoiceTime] >= #time(9, 0, 0) and [InvoiceTime] <= #time(12, 0, 0) then "9am - 12 noon"
				else
				if [InvoiceTime] >= #time(12, 0, 0) and [InvoiceTime] <= #time(15, 0, 0) then "12noon - 3pm"
				else
				if [InvoiceTime] >= #time(15, 0, 0) and [InvoiceTime] <= #time(18, 0, 0) then "3pm - 6pm"
				else
				if [InvoiceTime] >= #time(18, 0, 0) and [InvoiceTime] <= #time(21, 0, 0) then "6pm - 9pm"
				else
				if [InvoiceTime] >= #time(21, 0, 0) and [InvoiceTime] <= #time(23, 59, 59) then "9pm - Midnight"
				else 
				null, type text)
				in
				    #"Added Time Buckets"
				```

	annotation PBI_NavigationStepName = Navigation

